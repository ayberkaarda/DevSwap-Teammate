<%# Tek bir sohbet mesaji. terminal_chat_channel.js ICINDEKI buildMessageHTML ile
    AYNI DOM iskeletini uretir (id="msg-<id>", tiklanabilir kullanici adi, duzenle/sil
    kontrolleri, "(düzenlendi)" isareti, emoji tepki satiri) — server-render ile canli
    eklenen mesajlar birebir ayni gorunsun ve ayni Stimulus/ActionCable mantigi ikisinde
    de calissin diye. %>
<% can_edit = current_user && msg.user_id == current_user.id %>
<% can_delete = current_user && (msg.user_id == current_user.id || current_user.staff?) %>
<% reaction_counts = msg.message_reactions.group_by(&:emoji).transform_values(&:size) %>
<div id="msg-<%= msg.id %>" class="chat-msg group relative mb-1 font-mono text-sm leading-relaxed"
     data-controller="chat-message" data-chat-message-id-value="<%= msg.id %>">
  <div data-chat-message-target="display">
    <%= link_to msg.user.name, public_profile_path(msg.user_id),
          data: { turbo_frame: "_top" },
          class: "text-prompt-color font-bold hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-prompt-color rounded" %>
    <span class="text-terminal-text-muted">~%</span>
    <span class="text-terminal-text ml-2" data-chat-message-target="body"><%= msg.body %></span>
    <span data-chat-message-target="editedMarker"
          class="text-[9px] text-terminal-text-muted italic ml-1 <%= "hidden" unless msg.edited? %>">(düzenlendi)</span>

    <%# Hover'da beliren, gozu yormayan kucuk kontroller. %>
    <span class="inline-flex items-center gap-2 align-middle ml-1 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
      <button type="button" data-action="chat-message#togglePicker"
              class="text-terminal-text-muted hover:text-prompt-color text-xs leading-none" title="Tepki ver" aria-label="Tepki ver">☺</button>
      <% if can_edit %>
        <button type="button" data-action="chat-message#startEdit"
                class="text-[10px] text-terminal-text-muted hover:text-prompt-color tracking-widest">düzenle</button>
      <% end %>
      <% if can_delete %>
        <button type="button" data-action="chat-message#destroy"
                class="text-[10px] text-terminal-text-muted hover:text-red-400 tracking-widest">sil</button>
      <% end %>
    </span>
  </div>

  <%# Satir ici duzenleme formu (baslangicta gizli). %>
  <form class="hidden mt-1 flex items-center gap-2" data-chat-message-target="editForm"
        data-action="submit->chat-message#submitEdit">
    <input type="text" data-chat-message-target="editInput" value="<%= msg.body %>" autocomplete="off"
           class="flex-1 bg-terminal-bg border border-terminal-border rounded px-2 py-1 text-terminal-text text-xs font-mono focus:outline-none focus:border-prompt-color">
    <button type="submit" class="text-[10px] text-prompt-color border border-prompt-color/40 rounded px-2 py-1 hover:bg-prompt-color/10 transition-colors">Kaydet</button>
    <button type="button" data-action="chat-message#cancelEdit" class="text-[10px] text-terminal-text-muted hover:text-terminal-text px-1">İptal</button>
  </form>

  <%# Emoji secici paleti (baslangicta gizli). %>
  <div class="hidden mt-1 flex flex-wrap gap-1" data-chat-message-target="palette">
    <% MessageReaction::ALLOWED_EMOJI.each do |emoji| %>
      <button type="button" data-action="chat-message#react" data-emoji="<%= emoji %>"
              class="text-sm leading-none px-1.5 py-0.5 rounded border border-terminal-border bg-terminal-bg-2 hover:border-prompt-color transition-colors"><%= emoji %></button>
    <% end %>
  </div>

  <%# Mevcut tepki sayaci satiri (canli guncellenir: id="msg-reactions-<id>"). %>
  <div id="msg-reactions-<%= msg.id %>" class="flex flex-wrap gap-1 <%= "mt-1" if reaction_counts.any? %>">
    <% reaction_counts.each do |emoji, count| %>
      <button type="button" data-action="chat-message#react" data-emoji="<%= emoji %>"
              class="reaction-chip inline-flex items-center gap-0.5 text-[11px] leading-none px-1.5 py-0.5 rounded-full border border-prompt-color/30 bg-prompt-color/10 text-prompt-color hover:bg-prompt-color/20 transition-colors">
        <%= emoji %> <span><%= count %></span>
      </button>
    <% end %>
  </div>
</div>
