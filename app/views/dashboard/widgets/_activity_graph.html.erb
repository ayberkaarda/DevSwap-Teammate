<%# PLACEHOLDER (Faz 31d): gerçek katkı-grafiği mantığı ayrı fazda. Sadece kozmetik. %>
<div class="h-full border border-border-subtle bg-surface-1 p-4 font-mono text-xs text-text-muted flex flex-col"
     style="font-size: calc(1em * var(--widget-font-scale, 1));"
     data-widget-type="<%= widget.widget_type %>">
  <div class="flex items-center justify-between mb-3">
    <span class="text-accent tracking-widest uppercase">DevSwap Activity</span>
    <span class="text-text-secondary">geliyor</span>
  </div>

  <%# PLACEHOLDER (Faz 31d): gerçek aktivite verisi modeli henüz yok. Kullanıcının
      izlenebilir bir aktivitesi bulunmadığından, "bozuk/gizemli" görünmemesi için
      dekoratif grid'i soluk bir arka plana alıp açık bir boş-durum mesajı gösteriyoruz. %>
  <div class="flex-1 relative flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 flex items-center opacity-30 pointer-events-none" aria-hidden="true">
      <div class="grid grid-flow-col grid-rows-7 gap-[3px]">
        <% 52.times do |week| %>
          <% 7.times do |day| %>
            <%# Statik, sahte "aktivite" yoğunluğu — deterministik desen, gerçek veri değil. %>
            <% level = (week * 7 + day) % 5 %>
            <% opacity = [ "opacity-10", "opacity-20", "opacity-40", "opacity-60", "opacity-80" ][level] %>
            <span class="w-2 h-2 rounded-[2px] bg-accent <%= opacity %>"></span>
          <% end %>
        <% end %>
      </div>
    </div>
    <p class="relative z-10 text-center text-text-secondary px-3">
      Mevcut bir aktiviten bulunmamakta.
    </p>
  </div>

  <div class="mt-3 text-[10px] text-text-muted">
    DevSwap Activity — geliyor
  </div>
</div>
