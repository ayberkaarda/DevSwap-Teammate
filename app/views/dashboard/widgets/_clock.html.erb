<div class="h-full flex flex-col items-center justify-center border border-border-subtle bg-surface-1 p-4 font-mono text-text-muted" data-widget-type="<%= widget.widget_type %>" data-controller="clock" style="font-size: calc(1em * var(--widget-font-scale, 1));">
  <span class="text-accent text-[11px] tracking-widest uppercase mb-1">Sistem Saati</span>
  <span data-clock-target="time" class="text-3xl font-bold text-text-primary tabular-nums tracking-wider">--:--:--</span>
  <span data-clock-target="date" class="text-[11px] text-text-muted mt-1"></span>
</div>
