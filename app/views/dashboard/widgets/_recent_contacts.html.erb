<%
  # DM odalarını son mesaj zamanına göre (en yeni önce) sırala.
  dm_rooms = ChatRoom.dm_rooms_for(current_user).to_a
  rooms_by_recency = dm_rooms
                       .map { |room| [ room, room.messages.maximum(:created_at) ] }
                       .reject { |_room, last_at| last_at.nil? }
                       .sort_by { |_room, last_at| last_at }
                       .reverse
                       .map(&:first)
  contact_pages = rooms_by_recency.each_slice(4).to_a
%>
<div class="h-full border border-border-subtle bg-surface-1 p-4 font-mono text-xs text-text-muted flex flex-col"
     style="font-size: calc(1em * var(--widget-font-scale, 1));"
     data-widget-type="<%= widget.widget_type %>"
     <%= "data-controller=\"recent-contacts\"".html_safe if contact_pages.size > 1 %>>
  <div class="flex items-center justify-between mb-3">
    <span class="text-accent tracking-widest uppercase">Son Etkileşimler</span>
    <% if contact_pages.size > 1 %>
      <span data-recent-contacts-target="indicator" class="text-text-secondary">1 / <%= contact_pages.size %></span>
    <% end %>
  </div>

  <% if contact_pages.empty? %>
    <div class="flex-1 flex items-center justify-center text-text-muted">
      Henüz özel mesajın yok.
    </div>
  <% else %>
    <div class="flex-1">
      <% contact_pages.each_with_index do |page, page_index| %>
        <div data-recent-contacts-target="page" class="<%= "hidden" if page_index > 0 %> grid grid-cols-2 gap-2">
          <% page.each do |room| %>
            <% other = room.other_participant(current_user) %>
            <% next if other.nil? %>
            <% unread = room.messages.where(read_at: nil).where.not(user_id: current_user.id).exists? %>
            <%= link_to public_profile_path(other.id),
                        class: "relative flex items-center gap-2 border border-border-subtle bg-surface-2 px-2 py-2 hover:border-accent transition-colors" do %>
              <span class="relative shrink-0">
                <% if other.avatar_url.present? %>
                  <img src="<%= other.avatar_url %>" class="w-7 h-7 rounded-full" alt="">
                <% else %>
                  <span class="w-7 h-7 rounded-full bg-surface-3 flex items-center justify-center text-text-secondary uppercase">
                    <%= other.name.to_s.first %>
                  </span>
                <% end %>
                <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border border-surface-2 <%= other.is_online ? "bg-status-ok" : "bg-text-muted" %>"
                      title="<%= other.is_online ? "çevrimiçi" : "çevrimdışı" %>"></span>
              </span>
              <span class="truncate text-text-secondary flex-1"><%= other.name %></span>
              <% if unread %>
                <span class="shrink-0 w-2 h-2 rounded-full bg-accent" title="okunmamış mesaj"></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if contact_pages.size > 1 %>
      <div class="mt-3 flex items-center justify-between">
        <button type="button" data-action="recent-contacts#prev" data-recent-contacts-target="prevButton"
                class="border border-border-subtle bg-surface-2 px-2 py-1 hover:border-accent hover:text-accent transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
          ← Önceki
        </button>
        <button type="button" data-action="recent-contacts#next" data-recent-contacts-target="nextButton"
                class="border border-border-subtle bg-surface-2 px-2 py-1 hover:border-accent hover:text-accent transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
          Sonraki →
        </button>
      </div>
    <% end %>
  <% end %>
</div>
