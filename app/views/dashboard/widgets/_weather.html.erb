<div class="h-full border border-border-subtle bg-surface-1 p-4 font-mono text-xs text-text-muted flex flex-col"
     style="font-size: calc(1em * var(--widget-font-scale, 1));"
     data-widget-type="<%= widget.widget_type %>"
     data-controller="weather">
  <div class="flex items-center justify-between mb-3">
    <span class="text-accent tracking-widest uppercase">Hava Durumu</span>
    <span data-weather-target="status" class="text-text-secondary">Yükleniyor...</span>
  </div>

  <div class="flex-1 flex flex-col justify-center gap-1">
    <div class="flex items-baseline gap-2">
      <span data-weather-target="temp" class="text-2xl font-bold text-text-primary">--</span>
      <span data-weather-target="description" class="text-text-secondary"></span>
    </div>
    <div data-weather-target="wind" class="text-text-muted"></div>
  </div>
</div>
