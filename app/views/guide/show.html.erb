                </div>
              </div>
              <div class="bg-surface-1 border-x border-b border-border-subtle rounded-b-lg pt-10 pb-3 px-4 flex justify-between items-end">
                <div>
                  <h3 class="text-base font-bold text-text-primary dark:text-accent-fg">Ada Yılmaz</h3>
                  <p class="text-[9px] font-mono text-indigo-600 dark:text-indigo-400 uppercase tracking-widest mt-0.5">BACKEND DEVELOPER</p>
