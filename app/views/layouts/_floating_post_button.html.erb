<style>
  /* Yuzen "Post Oluştur" butonu — tum sayfalarda sol altta.
     Akis sayfasindayken (body[data-on-posts-feed="true"]) yumusakca kaybolur;
     ustteki sabit compose formu devralir. Ani kaybolma/belirme olmaz. */
  .floating-post-btn {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  body[data-on-posts-feed="true"] .floating-post-btn {
    opacity: 0;
    transform: translateY(1rem) scale(0.9);
    pointer-events: none;
  }

  /* Modal panel gecisi */
  .post-modal {
    border: none;
    padding: 0;
    background: transparent;
    /* Tailwind preflight tum elementlerde margin:0 uyguluyor; bu da native
       <dialog>'in varsayilan margin:auto ile ortalamasini bozuyor. Ortalamayi
       burada acikca kuruyoruz ki tarayici reset'ten bagimsiz calissin. */
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: calc(100vh - 2rem);
    max-width: min(32rem, calc(100vw - 2rem));
  }
  .post-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .post-modal[open] .post-modal-card {
    animation: postModalIn 0.25s ease both;
  }
  @keyframes postModalIn {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-post-btn { transition: none; }
    .post-modal[open] .post-modal-card { animation: none; }
  }
</style>

<div data-controller="floating-post-button">
  <button type="button"
          data-action="floating-post-button#open"
          class="floating-post-btn fixed bottom-6 left-6 z-40 flex items-center gap-2 bg-accent text-accent-fg px-4 py-3 rounded-full shadow-lg hover:scale-105 transition-all font-mono text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          aria-label="Post oluştur">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    <span class="hidden sm:inline">Post Oluştur</span>
  </button>

  <dialog data-floating-post-button-target="dialog"
          data-action="click->floating-post-button#backdropClick"
          class="post-modal w-full max-w-lg">
    <div class="post-modal-card bg-surface-1 border border-border-subtle shadow-2xl p-5 rounded"
         data-action="turbo:submit-end->floating-post-button#submitEnd">
      <div class="flex items-center justify-between mb-4 border-b border-border-subtle pb-2">
        <h2 class="text-xs font-mono text-accent tracking-widest">&gt; POST OLUŞTUR</h2>
        <button type="button" data-action="floating-post-button#close"
                class="text-text-muted hover:text-status-err font-mono text-sm" aria-label="Kapat">✕</button>
      </div>

      <%= form_with url: posts_path, method: :post, class: "flex flex-col gap-3", data: { controller: "tag-picker", action: "submit->tag-picker#commitPending" } do |form| %>
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-mono text-text-muted uppercase tracking-wider">Başlık</span>
          <%= form.text_field :title, placeholder: "Başlık (opsiyonel)", class: "bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-2 text-xs font-mono text-text-primary focus:border-accent focus:outline-none transition-colors", autocomplete: "off" %>
        </div>

        <div class="flex flex-col gap-1">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono text-text-muted uppercase tracking-wider">İçerik</span>
            <span data-floating-post-button-target="charCount" class="text-[10px] font-mono text-text-muted">0/500</span>
          </div>
          <%= form.text_area :content, placeholder: "Ağa bir durum raporu gönder...", rows: 3, maxlength: 500,
                data: { action: "input->floating-post-button#updateCharCount", floating_post_button_target: "content" },
                class: "bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-2 text-xs font-mono text-text-primary focus:border-accent focus:outline-none transition-colors", required: true %>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-mono text-text-muted uppercase tracking-wider">Etiketler</span>
          <datalist id="floating-post-skill-suggestions">
            <% Skill.order(:name).each do |skill| %>
              <option value="<%= skill.name %>" data-skill-id="<%= skill.id %>">
            <% end %>
          </datalist>

          <input type="text"
                 list="floating-post-skill-suggestions"
                 data-tag-picker-target="input"
                 data-action="change->tag-picker#add keydown->tag-picker#add"
                 placeholder="Etiket ekle — yetenek/araç yaz veya seç (ör: React)..."
                 autocomplete="off"
                 aria-label="Etiket ekle"
                 class="bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-2 text-xs font-mono text-text-primary focus:border-accent focus:outline-none transition-colors" />

          <div data-tag-picker-target="chips" class="flex flex-wrap gap-2 empty:hidden"></div>
        </div>

        <div class="flex justify-end gap-2 mt-1 pt-2 border-t border-border-subtle">
          <button type="button" data-action="floating-post-button#close"
                  class="text-text-muted hover:text-text-primary font-mono text-xs px-3 py-2">İptal</button>
          <%= form.submit "Yayınla", class: "bg-accent/10 text-accent border border-accent/30 px-4 py-2 rounded text-xs font-mono cursor-pointer hover:bg-accent/20 transition-all" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
