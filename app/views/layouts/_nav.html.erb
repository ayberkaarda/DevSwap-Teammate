<nav
  class="sticky top-0 z-50 w-full flex items-center justify-between gap-3 px-3 md:px-8 bg-surface-1 border-b border-border-subtle shadow-sm dark:shadow-none"
  style="height: var(--nav-h);"
>
  <div class="flex items-center gap-4 md:gap-6 min-w-0 overflow-x-auto">
    <span class="font-mono font-bold text-sm tracking-widest text-text-primary dark:text-accent whitespace-nowrap">DevSwap</span>

    <% if current_user %>
      <div class="flex items-center gap-3 md:gap-4 font-mono text-xs whitespace-nowrap">
      <%= link_to "Dashboard", root_path,
              class: "transition-colors #{controller_name == 'dashboard' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>

        <%= link_to "Postlar", posts_path,
              class: "transition-colors #{controller_name == 'posts' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>

        <% if current_user&.admin? %>
          <%= link_to "Telemetri", telemetry_path,
                class: "transition-colors #{controller_name == 'telemetry' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>
        <% end %>

        <% if current_user&.staff? %>
          <%= link_to "Kullanıcılar", admin_users_path,
                class: "transition-colors #{controller_path == 'admin/users' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>
        <% end %>

        <% if current_user&.admin? %>
          <%= link_to "Şikayetler", admin_complaints_path,
                class: "transition-colors #{controller_path == 'admin/complaints' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>
        <% end %>

        <%= link_to "Kontrol Kulesi", edit_profile_path,
              class: "transition-colors #{controller_name == 'profiles' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>

        <%= link_to "Yapabileceklerim", guide_path,
              class: "transition-colors #{controller_name == 'guide' ? 'text-accent font-bold' : 'text-text-muted hover:text-accent'}" %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3 shrink-0">
    <% if current_user %>
      <%= render "notifications/bell" %>
    <% end %>

    <details id="theme-toggle" class="relative font-mono" data-controller="theme" data-theme-target="menu">
      <summary id="theme-toggle-summary" class="list-none cursor-pointer flex items-center gap-1.5 p-2.5 rounded-full bg-surface-1 border border-border-subtle shadow-md dark:shadow-none text-text-primary dark:text-accent hover:scale-110 transition-all select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
        <span data-theme-target="icon" class="flex items-center justify-center"></span>
      </summary>

      <div class="absolute right-0 mt-2 w-44 z-50 bg-surface-1 border border-border-subtle rounded shadow-2xl py-1 text-xs">
        <p class="px-3 py-1.5 text-[10px] uppercase tracking-widest text-text-muted">Tema</p>
        <% [
             ["system", "Sistem"],
             ["light", "Açık"],
             ["dark", "Koyu"],
             ["dracula", "Dracula"],
             ["monokai", "Monokai"],
             ["nord", "Nord"],
             ["solarized", "Solarized"],
             ["gruvbox", "Gruvbox"],
             ["onedark", "One Dark"],
             ["tokyonight", "Tokyo Night"],
             ["matrix", "Matrix"]
           ].each do |mode, label| %>
          <button type="button"
                  data-theme-target="option"
                  data-theme-mode="<%= mode %>"
                  data-theme-mode-param="<%= mode %>"
                  data-action="click->theme#select"
                  class="w-full text-left px-3 py-1.5 text-text-muted hover:text-accent hover:bg-surface-2 transition-colors aria-[current=true]:text-accent aria-[current=true]:font-bold">
            <%= label %>
          </button>
        <% end %>
      </div>
    </details>

    <% if current_user %>
      <details class="relative font-mono text-xs whitespace-nowrap">
        <summary class="list-none cursor-pointer flex items-center gap-2 select-none">
          <% if current_user.avatar_url.present? %>
            <img src="<%= current_user.avatar_url %>" class="w-6 h-6 rounded-full" alt="">
          <% end %>
          <span class="hidden md:inline text-text-primary dark:text-accent"><%= current_user.name %></span>
        </summary>

        <div class="absolute right-0 mt-2 w-44 z-50 bg-surface-1 border border-border-subtle rounded shadow-2xl py-1 text-xs">
          <%= link_to "Profil", public_profile_path(current_user.id),
                class: "block px-3 py-1.5 text-text-muted hover:text-accent hover:bg-surface-2 transition-colors" %>
          <%= link_to "Ayarlar", settings_path,
                class: "block px-3 py-1.5 text-text-muted hover:text-accent hover:bg-surface-2 transition-colors" %>
          <div class="border-t border-border-subtle my-1"></div>
          <%= button_to "Çıkış", logout_path, method: :delete,
                class: "w-full text-left px-3 py-1.5 text-text-muted hover:text-status-err transition-colors cursor-pointer" %>
        </div>
      </details>
    <% end %>
  </div>
</nav>
