<div class="p-4">
  <h3 class="text-xs font-mono text-accent mb-3 tracking-widest">&gt; KİME GÖNDER</h3>
  <% if users.any? %>
    <ul class="flex flex-col gap-3">
      <% users.each do |u| %>
        <li data-share-name="<%= u.name %>" class="border-b border-border-subtle pb-2">
          <div class="flex items-center gap-2 mb-1">
            <% if u.avatar_url.present? %>
              <%= image_tag u.avatar_url, class: "w-6 h-6 rounded-full", alt: u.name %>
            <% else %>
              <span class="w-6 h-6 rounded-full bg-surface-2 border border-border-subtle inline-flex items-center justify-center text-[10px] font-mono text-text-muted"><%= u.name.to_s.first&.upcase %></span>
            <% end %>
            <span class="font-mono text-xs text-text-secondary"><%= u.name %></span>
          </div>
          <%= form_with url: share_post_path(post), method: :post, class: "flex gap-2" do |f| %>
            <%= hidden_field_tag :recipient_id, u.id %>
            <%= f.text_field :message, placeholder: "Ekstra mesaj (opsiyonel)...",
                  class: "flex-1 min-w-0 bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-1.5 text-[11px] font-mono text-text-primary focus:border-accent focus:outline-none",
                  autocomplete: "off" %>
            <%= f.submit "Gönder", class: "bg-accent/10 text-accent border border-accent/30 px-3 py-1.5 rounded text-[11px] font-mono cursor-pointer hover:bg-accent/20 transition-all" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-text-muted font-mono text-xs italic">Henüz mesajlaştığın kimse yok.</p>
  <% end %>
</div>
