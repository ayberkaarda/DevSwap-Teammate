<div id="post-compose" class="bg-surface-1 border border-border-subtle p-4 shadow-sm dark:shadow-none">
  <h2 class="text-xs font-mono text-accent mb-3 tracking-widest">&gt; POST OLUŞTUR</h2>

  <%= form_with url: posts_path, method: :post, class: "flex flex-col gap-2", data: { controller: "tag-picker", action: "submit->tag-picker#commitPending" } do |form| %>
    <%= hidden_field_tag :feed, "1" %>
    <%= form.text_field :title, placeholder: "Başlık (opsiyonel)", class: "bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-2 text-xs font-mono text-text-primary focus:border-accent focus:outline-none transition-colors", autocomplete: "off" %>
    <div class="flex gap-2">
      <%= form.text_field :content, placeholder: "Ağa bir durum raporu gönder...", class: "flex-1 bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-2 text-xs font-mono text-text-primary focus:border-accent focus:outline-none transition-colors", required: true, autocomplete: "off" %>
      <%= form.submit "Yayınla", class: "bg-accent/10 text-accent border border-accent/30 px-4 py-2 rounded text-xs font-mono cursor-pointer hover:bg-accent/20 transition-all" %>
    </div>

    <!-- Etiket secici: cirkin checkbox izgarasi yerine aranabilir, chip tabanli
         tag-picker (profiles/edit.html.erb'deki <datalist> autocomplete deseni).
         Secilen her yetenek gizli bir skill_ids[] input'u olarak eklenir. -->
    <div class="flex flex-col gap-2">
      <datalist id="post-skill-suggestions">
        <% Skill.order(:name).each do |skill| %>
          <option value="<%= skill.name %>" data-skill-id="<%= skill.id %>">
        <% end %>
      </datalist>

      <input type="text"
             list="post-skill-suggestions"
             data-tag-picker-target="input"
             data-action="change->tag-picker#add keydown->tag-picker#add"
             placeholder="Etiket ekle — yetenek/araç yaz veya seç (ör: React)..."
             autocomplete="off"
             aria-label="Etiket ekle"
             class="bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-2 text-xs font-mono text-text-primary focus:border-accent focus:outline-none transition-colors" />

      <div data-tag-picker-target="chips" class="flex flex-wrap gap-2 empty:hidden"></div>
    </div>
  <% end %>
</div>
