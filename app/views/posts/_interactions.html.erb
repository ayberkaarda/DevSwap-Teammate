<%# Post etkilesim cubugu (like / yorum / repost / kaydet / gonder). local: post %>
<%# turbo_stream ile YERINDE guncellenir; kok id sabit kalmali. %>
<% liked    = current_user && post.likes.any? { |l| l.user_id == current_user.id } %>
<% reposted = current_user && post.reposts.any? { |r| r.user_id == current_user.id } %>
<% saved    = current_user && post.saved_posts.any? { |s| s.user_id == current_user.id } %>

<div id="post_<%= post.id %>_interactions" class="mt-3 pt-3 border-t border-border-subtle">
  <div class="flex items-center gap-1 text-text-muted">
    <!-- BEGEN -->
    <div class="flex items-center" data-controller="list-popover" data-list-popover-url-value="<%= post_likers_path(post) %>">
      <% if current_user %>
        <%= button_to toggle_post_like_path(post),
              class: "group flex items-center gap-1.5 px-2 py-1.5 rounded-lg #{liked ? 'text-rose-600 dark:text-rose-500 dark:text-rose-400' : 'text-text-muted'} hover:bg-rose-500/10 hover:text-rose-500 transition-all cursor-pointer",
              aria: { label: (liked ? 'Beğeniyi kaldır' : 'Beğen') } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="<%= liked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" class="group-active:scale-90 transition-transform">
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
          </svg>
        <% end %>
      <% else %>
        <span class="flex items-center px-2 py-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </span>
      <% end %>
      <button type="button" data-action="list-popover#open" class="text-[11px] font-mono pr-1 hover:text-accent transition-colors cursor-pointer" title="Beğenenleri gör"><%= post.likes.size %></button>

      <dialog data-list-popover-target="dialog" data-action="click->list-popover#backdrop"
              class="post-modal w-full max-w-sm bg-surface-1 border border-border-subtle rounded shadow-2xl">
        <div class="flex justify-end p-2">
          <button type="button" data-action="list-popover#close" class="text-text-muted hover:text-status-err text-sm" aria-label="Kapat">✕</button>
        </div>
        <div data-list-popover-target="content"></div>
      </dialog>
    </div>

    <!-- YORUM -->
    <%= link_to post_path(post), class: "flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-text-muted hover:bg-accent/10 hover:text-accent transition-all", title: "Yorumları gör" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="text-[11px] font-mono"><%= post.comments.size %></span>
    <% end %>

    <!-- REPOST -->
    <div class="flex items-center" data-controller="list-popover" data-list-popover-url-value="<%= post_reposters_path(post) %>">
      <% if current_user %>
        <%= button_to toggle_repost_path(post),
              class: "group flex items-center gap-1.5 px-2 py-1.5 rounded-lg #{reposted ? 'text-emerald-700 dark:text-emerald-500 dark:text-emerald-400' : 'text-text-muted'} hover:bg-emerald-500/10 hover:text-emerald-500 transition-all cursor-pointer",
              aria: { label: (reposted ? 'Yeniden paylaşımı geri al' : 'Yeniden paylaş') } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-active:scale-90 transition-transform"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
        <% end %>
      <% else %>
        <span class="flex items-center px-2 py-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></span>
      <% end %>
      <button type="button" data-action="list-popover#open" class="text-[11px] font-mono pr-1 hover:text-accent transition-colors cursor-pointer" title="Yeniden paylaşanları gör"><%= post.reposts.size %></button>

      <dialog data-list-popover-target="dialog" data-action="click->list-popover#backdrop"
              class="post-modal w-full max-w-sm bg-surface-1 border border-border-subtle rounded shadow-2xl">
        <div class="flex justify-end p-2">
          <button type="button" data-action="list-popover#close" class="text-text-muted hover:text-status-err text-sm" aria-label="Kapat">✕</button>
        </div>
        <div data-list-popover-target="content"></div>
      </dialog>
    </div>

    <!-- GONDER (DM) — alicilar GORUNMEZ (gizlilik), yalnizca sayi -->
    <div class="flex items-center">
      <% if current_user %>
        <div class="flex items-center" data-controller="share" data-share-url-value="<%= post_share_targets_path(post) %>">
          <button type="button" data-action="share#open" class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-text-muted hover:bg-accent/10 hover:text-accent transition-all cursor-pointer" title="DM olarak gönder" aria-label="Gönder">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span class="text-[11px] font-mono" title="Gönderilme sayısı (kimlere gönderildiği gizlidir)"><%= post.post_shares.size %></span>
          </button>

          <dialog data-share-target="dialog" data-action="click->share#backdrop turbo:submit-end->share#submitEnd"
                  class="post-modal w-full max-w-md bg-surface-1 border border-border-subtle rounded shadow-2xl">
            <div class="flex items-center justify-between p-3 border-b border-border-subtle">
              <input type="text" data-share-target="search" data-action="input->share#filter"
                     placeholder="Kişi ara (herkeste arayabilirsin)..."
                     class="flex-1 min-w-0 bg-surface-2 dark:bg-terminal-bg border border-border-subtle rounded p-1.5 text-[11px] font-mono text-text-primary focus:border-accent focus:outline-none" />
              <button type="button" data-action="share#close" class="ml-2 text-text-muted hover:text-status-err text-sm" aria-label="Kapat">✕</button>
            </div>
            <div data-share-target="content" class="max-h-[60vh] overflow-y-auto custom-scrollbar"></div>
          </dialog>
        </div>
      <% else %>
        <span class="flex items-center gap-1.5 px-2 py-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg><span class="text-[11px] font-mono"><%= post.post_shares.size %></span></span>
      <% end %>
    </div>

    <!-- KAYDET (saga yaslanir) -->
    <div class="ml-auto flex items-center">
      <% if current_user %>
        <%= button_to toggle_save_post_path(post),
              class: "group flex items-center px-2 py-1.5 rounded-lg #{saved ? 'text-amber-700 dark:text-amber-500 dark:text-amber-400' : 'text-text-muted'} hover:bg-amber-500/10 hover:text-amber-500 transition-all cursor-pointer",
              aria: { label: (saved ? 'Kaydı kaldır' : 'Kaydet') }, title: (saved ? 'Kaydı kaldır' : 'Kaydet') do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="<%= saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-active:scale-90 transition-transform"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
