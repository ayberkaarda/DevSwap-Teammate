<%# Infinite scroll: yeni post kartlarini listenin altina ekle, %>
<%# ardindan sentinel'i (bir sonraki sayfa bilgisiyle) tazele. %>
<%= turbo_stream.append "posts-list" do %>
  <% @posts.each do |post| %>
    <%= render "posts/post", post: post %>
  <% end %>
<% end %>

<%= turbo_stream.replace "posts-sentinel" do %>
  <%= render "posts/sentinel", next_page: @next_page %>
<% end %>
