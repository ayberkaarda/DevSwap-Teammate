<%# learning_skills: profile_user'ın öğrenmek istediği yetenekler (relation). %>
<% learning_skills = profile_user.user_skills.where(direction: "learning").includes(:skill).order(Arel.sql("weight DESC NULLS LAST")) %>
<div class="h-full bg-surface-1 border border-border-subtle p-6 overflow-auto"
     style="font-size: calc(1em * var(--widget-font-scale, 1));">
  <h3 class="text-indigo-700 dark:text-indigo-300 text-sm font-bold uppercase tracking-widest mb-4 font-mono">await learnSkills();</h3>
  <% if learning_skills.empty? %>
    <p class="text-xs font-mono text-text-muted">[SYS] Hedef listesi boş.</p>
  <% else %>
    <div class="flex flex-wrap gap-3">
      <% learning_skills.each do |us| %>
        <div class="flex flex-col">
          <div class="flex items-center gap-2 bg-indigo-500/10 dark:bg-indigo-500/15 border border-indigo-600/30 dark:border-indigo-400/30 px-3 py-1.5 rounded-sm">
            <span class="text-indigo-700 dark:text-indigo-300 text-sm"><%= us.skill.name %></span>
            <% if us.respond_to?(:proficiency_level) && us.proficiency_level.present? %>
              <span class="text-[9px] font-mono uppercase tracking-widest text-indigo-600 dark:text-indigo-300 border border-indigo-600/30 dark:border-indigo-400/30 px-1 py-0.5 rounded">
                <%= { "beginner" => "Başlangıç", "intermediate" => "Orta", "advanced" => "İleri", "expert" => "Uzman" }[us.proficiency_level] || us.proficiency_level %>
              </span>
            <% end %>
            <% if us.respond_to?(:evidence_url) && us.evidence_url.present? %>
              <%= link_to "🔗", safe_url(us.evidence_url), target: "_blank", rel: "noopener noreferrer", class: "text-[10px] text-indigo-600 dark:text-indigo-300 hover:opacity-80", title: "Kanıt linki" %>
            <% end %>
          </div>
          <% if us.respond_to?(:note) && us.note.present? %>
            <p class="text-[10px] italic text-text-muted mt-0.5 max-w-[12rem] truncate" title="<%= us.note %>"><%= us.note %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
