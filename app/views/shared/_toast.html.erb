<%
  variant ||= :success
  color = variant.to_sym == :error ? "border-status-err/40 text-rose-700 dark:text-status-err" : "border-accent/40 text-accent"
%>
<div class="toast pointer-events-auto flex items-center gap-2 bg-surface-1 border <%= color %> shadow-lg px-4 py-2.5 rounded font-mono text-xs"
     data-controller="toast" role="status">
  <%= message %>
</div>
