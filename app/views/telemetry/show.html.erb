<%= turbo_stream_from "telemetry_dashboard" %>
<%= render "widgets", snapshot: @snapshot, history: @history, htop: @htop %>


<% if current_user&.admin? %>
<div class="max-w-5xl mx-auto px-4 py-4">
  <div class="mt-8 border-t border-border-subtle pt-6">
    <h2 class="text-sm font-mono text-accent tracking-widest mb-4"><span class="inline-block bg-accent/10 border border-accent/30 rounded px-2 py-1">&gt; DUYURU_YAYINI (broadcast)</span></h2>

    <%= form_with url: admin_broadcasts_path, method: :post, class: "flex flex-col gap-2 mb-4" do %>
      <textarea name="message" maxlength="500" required placeholder="Ağa duyuru gönder... (maks. 500 karakter)" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary"></textarea>
      <select name="duration_hours" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary">
        <option value="1">1 saat</option>
        <option value="6">6 saat</option>
        <option value="24" selected>1 gün</option>
        <option value="168">1 hafta</option>
        <option value="">Süresiz</option>
      </select>
      <button type="submit" class="bg-accent/20 border border-accent/60 text-accent text-xs font-mono px-3 py-1.5 rounded hover:bg-accent/30">Duyuruyu Yayınla</button>
    <% end %>

    <% if @recent_broadcasts.present? %>
      <div class="space-y-2">
        <% @recent_broadcasts.each do |broadcast| %>
          <div class="flex items-center justify-between gap-3 text-xs font-mono border border-border-subtle rounded px-3 py-2">
            <div class="min-w-0 flex-1">
              <p class="text-text-primary break-words"><%= broadcast.message %></p>
              <p class="text-text-muted text-[10px] mt-1">
                <%= broadcast.admin.name %> · <%= broadcast.created_at.strftime("%d.%m.%Y %H:%M") %>
              </p>
            </div>
            <%= button_to "Sil", admin_broadcast_path(broadcast), method: :delete, class: "shrink-0 text-[10px] text-text-muted hover:text-red-600 dark:hover:text-red-400" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 border-t border-border-subtle pt-6">
    <h2 class="text-sm font-mono text-accent tracking-widest mb-4"><span class="inline-block bg-accent/10 border border-accent/30 rounded px-2 py-1">&gt; ROL_ATAMA (root)</span></h2>

    <div class="border border-border-subtle rounded overflow-x-auto">
      <table class="w-full text-xs font-mono">
        <thead class="bg-surface-2 text-text-muted">
          <tr>
            <th class="text-left px-3 py-2">Kullanıcı</th>
            <th class="text-left px-3 py-2">İletişim</th>
            <th class="text-left px-3 py-2">Rol</th>
            <th class="text-left px-3 py-2">İşlem</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <% @users.each do |u| %>
            <tr class="even:bg-surface-1/50 align-top">
              <td class="px-3 py-2 text-text-secondary"><%= u.name.presence || "(isimsiz)" %></td>
              <td class="px-3 py-2 text-text-muted">
                <div><%= u.email.presence || "—" %></div>
                <% if u.github_username.present? %>
                  <div class="text-[10px]">@<%= u.github_username %></div>
                <% end %>
              </td>
              <td class="px-3 py-2 text-text-secondary">
                <% if u.protected_from_moderation? %>
                  <span class="text-[10px] text-accent border border-accent/40 rounded px-1" title="Bu hesap moderasyondan korunuyor">korumalı</span>
                <% else %>
                  <%= form_with url: user_role_path(u), method: :patch do %>
                    <select name="role" onchange="this.form.requestSubmit()" class="bg-surface-1 border border-border-subtle text-[10px] font-mono px-1 py-1 rounded text-text-primary">
                      <option value="member" <%= "selected" if u.role == "member" %>>Üye</option>
                      <option value="moderator" <%= "selected" if u.role == "moderator" %>>Moderatör</option>
                      <option value="admin" <%= "selected" if u.role == "admin" %>>Admin</option>
                    </select>
                  <% end %>
                <% end %>
              </td>
              <td class="px-3 py-2">
                <% if user_muted?(u) %>
                  <span class="text-[10px] text-text-muted italic px-2 py-1">zaten susturulmuş</span>
                <% else %>
                  <%= form_with url: mutes_path, method: :post, class: "flex flex-wrap items-center gap-1" do %>
                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                    <select name="duration_minutes" class="bg-surface-1 border border-border-subtle text-[10px] font-mono px-1 py-1 rounded text-text-primary">
                      <option value="15">15 dakika</option>
                      <option value="30">30 dakika</option>
                      <option value="60" selected>1 saat</option>
                      <option value="360">6 saat</option>
                      <option value="1440">24 saat</option>
                      <option value="10080">1 hafta</option>
                    </select>
                    <input type="text" name="reason" value="admin panelinden susturuldu" class="bg-surface-1 border border-border-subtle text-[10px] font-mono px-1 py-1 rounded text-text-primary w-32" />
                    <button type="submit" class="bg-yellow-900/20 border border-yellow-700/60 text-yellow-700 dark:text-yellow-400 text-xs font-mono px-3 py-1 rounded hover:bg-yellow-900/40">Sustur</button>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-8 border-t border-border-subtle pt-6">
    <h2 class="text-sm font-mono text-accent tracking-widest mb-4"><span class="inline-block bg-accent/10 border border-accent/30 rounded px-2 py-1">&gt; KULLANICI_AKTİVİTE_LOGU (root)</span></h2>

    <%= form_with url: telemetry_path, method: :get, data: { turbo_frame: "activity_log_frame" }, class: "flex flex-wrap items-center gap-2 mb-4" do %>
      <select name="user_id" onchange="this.form.requestSubmit()" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary">
        <option value="">Kullanıcı seç...</option>
        <% @users.each do |u| %>
          <option value="<%= u.id %>" <%= "selected" if @selected_user&.id == u.id %>><%= u.name %></option>
        <% end %>
      </select>

      <select name="log_type" onchange="this.form.requestSubmit()" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded">
        <option value="">Tüm loglar</option>
        <option value="login" <%= "selected" if params[:log_type] == "login" %>>Giriş</option>
        <option value="logout" <%= "selected" if params[:log_type] == "logout" %>>Çıkış</option>
        <option value="message_sent" <%= "selected" if params[:log_type] == "message_sent" %>>Mesaj</option>
        <option value="dm_sent" <%= "selected" if params[:log_type] == "dm_sent" %>>DM</option>
        <option value="skill_added" <%= "selected" if params[:log_type] == "skill_added" %>>Yetenek eklendi</option>
        <option value="rating_given" <%= "selected" if params[:log_type] == "rating_given" %>>Değerlendirme</option>
      </select>

      <% if @selected_user %>
        <select name="dm_with_user_id" onchange="this.form.requestSubmit()" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary">
          <option value="">DM incelemesi yok</option>
          <% @users.each do |u| %>
            <% next if u.id == @selected_user.id %>
            <option value="<%= u.id %>" <%= "selected" if @dm_other_user&.id == u.id %>><%= u.name %> ile DM</option>
          <% end %>
        </select>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "activity_log_frame" do %>
      <% if @selected_user %>
        <div class="border border-border-subtle rounded overflow-hidden">
          <table class="w-full text-xs font-mono">
            <thead class="bg-surface-2 text-text-muted">
              <tr>
                <th class="text-left px-3 py-2">Zaman</th>
                <th class="text-left px-3 py-2">Tür</th>
                <th class="text-left px-3 py-2">Detay</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-subtle">
              <% @activity_timeline.each do |event| %>
                <tr>
                  <td class="px-3 py-2 text-text-muted whitespace-nowrap"><%= event.created_at.strftime("%d.%m.%Y %H:%M:%S") %></td>
                  <td class="px-3 py-2 text-accent"><%= event.action_type %></td>
                  <td class="px-3 py-2 text-text-secondary"><%= event.detail %></td>
                </tr>
              <% end %>
              <% if @activity_timeline.empty? %>
                <tr><td colspan="3" class="px-3 py-4 text-center text-text-muted">Kayıt yok.</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @dm_thread %>
          <div class="mt-6">
            <h3 class="text-xs font-mono text-accent tracking-widest mb-3">
              &gt; DM: <%= @selected_user.name %> ↔ <%= @dm_other_user.name %>
            </h3>
            <div class="border border-border-subtle rounded divide-y divide-border-subtle">
              <% @dm_thread.each do |message| %>
                <div class="px-3 py-2 text-xs font-mono">
                  <span class="text-text-muted whitespace-nowrap"><%= message.created_at.strftime("%d.%m.%Y %H:%M:%S") %></span>
                  <span class="text-accent">&nbsp;<%= message.user.name %>:</span>
                  <span class="text-text-secondary">&nbsp;<%= message.body %></span>
                </div>
              <% end %>
              <% if @dm_thread.empty? %>
                <div class="px-3 py-4 text-center text-text-muted">Mesaj yok.</div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 border-t border-border-subtle pt-4">
    <h3 class="text-xs font-mono text-accent tracking-widest mb-3"><span class="inline-block bg-accent/10 border border-accent/30 rounded px-2 py-1">&gt; BAN_YÖNETİMİ (root)</span></h3>

    <%= form_with url: bans_path, method: :post, class: "flex flex-col gap-2 mb-4" do %>
      <select name="user_id" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary">
        <% @users.each do |u| %>
          <option value="<%= u.id %>"><%= u.name %> (<%= u.provider.presence || "hesap yok" %>)</option>
        <% end %>
      </select>
      <input type="number" name="duration_days" placeholder="Süre (gün, boş=süresiz)" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary" />
      <textarea name="reason" placeholder="Açıklama" class="bg-surface-1 border border-border-subtle text-xs font-mono px-2 py-1 rounded text-text-primary"></textarea>
      <button type="submit" class="bg-red-900/30 border border-red-700 text-red-600 dark:text-red-400 text-xs font-mono px-3 py-1.5 rounded hover:bg-red-900/50">Banla</button>
    <% end %>

    <% BannedAccount.active.includes(:banned_by).each do |ban| %>
      <div class="flex items-center justify-between text-xs font-mono border-b border-border-subtle py-2">
        <span class="text-text-secondary"><%= ban.provider %>/<%= ban.uid %> — <%= ban.reason %> (<%= ban.permanent? ? "süresiz" : "#{ban.banned_until.strftime('%d.%m.%Y')}'e kadar" %>)</span>
        <%= button_to "Kaldır", ban_path(ban), method: :delete, class: "text-[10px] text-text-muted hover:text-red-600 dark:hover:text-red-400" %>
      </div>
    <% end %>
  </div>
</div>
<% end %>
